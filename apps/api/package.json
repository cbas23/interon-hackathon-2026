{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/local.ts",
    "build": "bun build src/lambda.ts --target=node --format=cjs --outfile=dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "@hono/node-server": "latest",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.37",
    "hono": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "latest",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "tsx": "latest",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
