{
  "name": "recmeds",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "build": "bun run build:web && bun run build:api",
    "build:web": "bun --cwd apps/web build",
    "build:api": "bun --cwd apps/api build",
    "lint": "bun --cwd apps/web lint && bun --cwd apps/api lint",
    "format": "prettier --write apps/web apps/api",
    "format:check": "prettier --check apps/web apps/api",
    "deploy": "bun run deploy:api && bun run deploy:web",
    "deploy:api": "bun --cwd apps/api deploy",
    "deploy:web": "bun --cwd apps/web deploy"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
